{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "dev": "tsx server.ts",
    "build": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "tsx --test .storybook/handlers.test.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "tsx --test src/**/*.test.ts shared/**/*.test.ts server/*.test.ts server/**/*.test.ts scripts/*.test.mjs",
    "playwright:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:server": "vite --host 127.0.0.1 --port 3100 --strictPort",
    "test:ui": "playwright test --ui --ui-host=127.0.0.1 --ui-port=9323",
    "test:report": "playwright show-report --host 127.0.0.1",
    "test:agent:live": "COPILOT_LIVE_TEST=1 tsx --test server/agents/copilotProvider.test.ts",
    "test:agent:skills": "COPILOT_SKILL_TEST=1 tsx --test server/agents/graphifySkill.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.27",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.12",
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "msw": "^2.12.0",
    "msw-storybook-addon": "^2.0.0",
    "prisma": "^6.19.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
